{
  "version": 1,
  "product": {
    "name": "Canopus Assistant",
    "tagline": "Your AI observing companion",
    "iconEmoji": "🔭"
  },
  "badge": {
    "show": true,
    "label": "Meet Canopus Assistant"
  },
