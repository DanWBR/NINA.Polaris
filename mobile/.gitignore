# Capacitor mobile app -- generated/native platform output + deps.
# The hand-written sources (www/, plugins/polaris-onnx/src + android +
# ios plugin code, configs) ARE committed; the generated native host
# projects and node_modules are not.

node_modules/
plugins/*/node_modules/
plugins/*/dist/

# Plugin Gradle build output (the plugin's android/ SOURCE is committed,
# but its compiled build/ + .gradle/ are not).
plugins/*/android/build/
plugins/*/android/.gradle/

# Capacitor-generated native host projects (recreate with `npx cap add`)
/android/
/ios/

# Build artifacts
dist/
www/build/
*.apk
*.aab
*.ipa
.gradle/
DerivedData/
Pods/

# Editor / OS
.DS_Store
*.log
.idea/
.vscode/
