<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Download the GGUF and talk to the loopback server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The model host runs as a foreground service so Doze / OEM power
         managers do not kill it mid-session (MIUI reaped the eval harness
         after ~2 min). Android 14+ needs the typed permission too. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="dev.danwbr.polaris.llama.LlamaServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
