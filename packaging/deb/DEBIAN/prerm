#!/bin/bash
# Polaris pre-remove: stops the service cleanly before dpkg removes
# the binary. Runs before files are deleted so the running process
# does not see its own executable disappear mid-flight.

set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            if systemctl is-active --quiet polaris.service; then
                systemctl stop polaris.service
            fi
            # indi-web runs as its own unit precisely so it is NOT stopped with
            # polaris.service -- which means an actual removal has to stop it
            # here, or it keeps running with its ExecStart about to vanish.
            # Only on remove: an upgrade is the case the separate unit exists
            # for, and the drivers must ride it out.
            if [ "$1" = "remove" ]                && systemctl is-active --quiet polaris-indiweb.service; then
                systemctl stop polaris-indiweb.service || true
            fi
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
