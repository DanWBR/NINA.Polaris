# .pkla twin of ../../rules.d/50-polaris-clock.rules for polkit < 0.106
# (e.g. Ubuntu 22.04). Lets the polaris user set the system time and
# toggle NTP (used by the "Sync time" clock feature).
[Polaris passwordless clock / NTP (polkit < 0.106)]
Identity=unix-user:polaris
Action=org.freedesktop.timedate1.set-time;org.freedesktop.timedate1.set-ntp
ResultAny=yes
ResultInactive=yes
ResultActive=yes
