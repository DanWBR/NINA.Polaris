# .pkla twin of ../../rules.d/50-polaris-power.rules for polkit < 0.106
# (e.g. Ubuntu 22.04). Lets the polaris user reboot / power off the
# appliance from the UI without a password. The manage-units part of the
# .rules (restart polaris.service) is already covered by the broad
# manage-units grant in 50-polaris-update.pkla.
[Polaris passwordless reboot / power-off (polkit < 0.106)]
Identity=unix-user:polaris
Action=org.freedesktop.login1.reboot;org.freedesktop.login1.reboot-multiple-sessions;org.freedesktop.login1.power-off;org.freedesktop.login1.power-off-multiple-sessions
ResultAny=yes
ResultInactive=yes
ResultActive=yes
