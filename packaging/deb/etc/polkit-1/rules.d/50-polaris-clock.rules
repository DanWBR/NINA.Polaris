// TWIN: keep in sync with ../localauthority/50-local.d/50-polaris-clock.pkla
// (that .pkla covers polkit < 0.106 / Ubuntu 22.04, which ignores this JS format).
// PolicyKit rule shipped by the polaris .deb. Grants the 'polaris'
// system user (created in postinst) the ability to set the system
// wall clock via timedatectl, used by ClockSyncService when the
// browser POSTs /api/system/clock/sync.
//
// Background: a Pi without an RTC battery + offline (no NTP) drifts.
// The browser knows the right UTC because its own host is online;
// Polaris lets the user push that timestamp into the Pi with one
// click. timedatectl requires PolicyKit auth, so without this rule
// the call fails silently as "Not authorized".
//
// set-timezone rides along for the same reason: the images ship as UTC
// and nothing ever moved them, so DATE-LOC in every saved FITS equalled
// DATE-UTC and the astronomical session-date folder rolled at the wrong
// hour for anyone not on UTC. The browser knows where the operator is
// and sends its IANA zone with the clock.
//
// Scope is intentionally narrow: only set-time, set-ntp and set-timezone
// (the actions ClockSyncService invokes), only the polaris user. Other
// users keep their normal PolicyKit defaults.
polkit.addRule(function(action, subject) {
    if (subject.user != "polaris") return;
    if (action.id == "org.freedesktop.timedate1.set-time"
        || action.id == "org.freedesktop.timedate1.set-ntp"
        || action.id == "org.freedesktop.timedate1.set-timezone") {
        return polkit.Result.YES;
    }
});
