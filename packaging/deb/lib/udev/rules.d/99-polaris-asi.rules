# N.I.N.A. Polaris — ZWO ASI camera USB access (from the ASI SDK).
# Bumps usbfs memory so high-fps USB3 streaming has enough buffer (the
# 16 MB default drops frames on large/fast ROIs), and grants non-root
# access to ASI devices. Reloaded by the package postinst.
ACTION=="add", ATTR{idVendor}=="03c3", RUN+="/bin/sh -c '/bin/echo 200 >/sys/module/usbcore/parameters/usbfs_memory_mb'"
SUBSYSTEMS=="usb", ATTR{idVendor}=="03c3", MODE="0666"
