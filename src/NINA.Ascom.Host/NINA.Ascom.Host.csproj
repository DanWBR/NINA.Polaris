<Project Sdk="Microsoft.NET.Sdk">

  <!-- WINEXIT-2 (#650): the win-x86 out-of-process host for a single ASCOM COM
       driver. Polaris runs 64-bit; a 32-bit-only in-proc ASCOM driver cannot
       load in the 64-bit app, so it runs here instead. The protocol loop is
       shared (NINA.Ascom.Com.AscomComHostRunner) with the x64 self-host path
       — this project is just the thin x86 entry point, published self-contained
       for win-x86 and staged next to the app by the Polaris csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NINA.Ascom.Host</RootNamespace>
    <AssemblyName>NINA.Ascom.Host</AssemblyName>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NINA.Ascom.Com\NINA.Ascom.Com.csproj" />
  </ItemGroup>

</Project>
