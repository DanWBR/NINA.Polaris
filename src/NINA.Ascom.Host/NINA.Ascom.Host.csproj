<Project Sdk="Microsoft.NET.Sdk">

  <!-- WINEXIT-2 (#650): out-of-process host for a single ASCOM COM driver.
       Polaris runs 64-bit; a 32-bit-only in-proc ASCOM driver (e.g. a DIY
       MilkyWheel filter wheel) cannot load in the 64-bit host, and a badly
       behaved driver can take a whole process down with a corrupted-state
       exception a managed try/catch can't see. Isolating the driver in this
       tiny child process fixes both: the child is published for BOTH win-x86
       and win-x64, the parent launches the bitness that matches the driver's
       registration, and a driver crash kills only the child.

       Deliberately lean — no NINA.Core / NINA.Image reference — so the
       self-contained single-file publish for each RID stays small. The STA
       pump and the COM member access are copied (not shared) from
       NINA.Ascom.Com for exactly that reason; keep them in sync. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NINA.Ascom.Host</RootNamespace>
    <AssemblyName>NINA.Ascom.Host</AssemblyName>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <!-- The two bitnesses the parent may launch. The self-contained
         single-file publish for each is driven by the Polaris csproj. -->
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <!-- Not referenced by any other project; it ships as a standalone exe
         copied next to the app. Building it with the solution just
         compile-checks it (framework-dependent AnyCPU). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
