<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NINA.Camera.ZwoSdk</RootNamespace>
    <AssemblyName>NINA.Camera.ZwoSdk</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ZWO ASI SDK ships native binaries for Windows (x64/x86) and Linux
         (armv6/7/8, x64/x86) + macOS. net10.0, no OS attribute: compiles
         cross-platform, ZwoRegistry probes at runtime. The per-RID native
         lib is copied into the app output by the items below. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NINA.Core.Portable\NINA.Core.Portable.csproj" />
    <ProjectReference Include="..\NINA.Image.Portable\NINA.Image.Portable.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AsiSdk>$(MSBuildThisFileDirectory)..\..\camera_sdk\ZWO</AsiSdk>
    <AsiLinux>$(AsiSdk)\ASI_linux_mac_SDK_V1.41\lib</AsiLinux>
    <AsiWin>$(AsiSdk)\ASI_Windows_SDK_V1.41\ASI SDK\lib</AsiWin>
  </PropertyGroup>
  <!-- No <Content> for the native SDK here, on any platform.
       Linux takes the libraries from the indi-3rdparty packages (libtoupcam,
       libaltaircam, libasi, libsvbony, libplayerone), which the .deb
       Recommends. Windows takes them from the vendor driver package the
       operator installs for the cameras they actually own; the portable zip
       says so on the download page.
       An item here would be fiction either way: it sets
       CopyToOutputDirectory, and content from a ProjectReference does not
       reach the referencing app's publish output. Verified by publishing for
       both RIDs: the managed assemblies arrive, the native ones never did,
       and nobody noticed because every host already had them. -->

</Project>
