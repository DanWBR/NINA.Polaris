<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NINA.Camera.ZwoSdk</RootNamespace>
    <AssemblyName>NINA.Camera.ZwoSdk</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ZWO ASI SDK ships native binaries for Windows (x64/x86) and Linux
         (armv6/7/8, x64/x86) + macOS. net10.0, no OS attribute: compiles
         cross-platform, ZwoRegistry probes at runtime. The per-RID native
         lib is copied into the app output by the items below. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NINA.Core.Portable\NINA.Core.Portable.csproj" />
    <ProjectReference Include="..\NINA.Image.Portable\NINA.Image.Portable.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AsiSdk>$(MSBuildThisFileDirectory)..\..\camera_sdk\ZWO</AsiSdk>
    <AsiLinux>$(AsiSdk)\ASI_linux_mac_SDK_V1.41\lib</AsiLinux>
    <AsiWin>$(AsiSdk)\ASI_Windows_SDK_V1.41\ASI SDK\lib</AsiWin>
  </PropertyGroup>
  <!-- No Linux <Content> here on purpose. The native camera libraries come
       from the indi-3rdparty packages (libtoupcam, libaltaircam, libasi,
       libsvbony, libplayerone), which the .deb Recommends, and dlopen finds
       them on the default search path. A <Content> item declared here would
       be fiction anyway: it sets CopyToOutputDirectory, and content from a
       ProjectReference does not flow into the referencing app's publish
       output, so nothing was ever shipped and nobody noticed because every
       image already had the system packages. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="$(AsiWin)\x64\ASICamera2.dll">
      <Link>ASICamera2.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
