<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NINA.Guider.Portable</RootNamespace>
    <AssemblyName>NINA.Guider.Portable</AssemblyName>
    <!-- Pure, portable native-autoguider math ported from PHD2 (BSD-3-Clause,
         OpenPHDGuiding). No HTTP / INDI / UI dependencies so it stays
         unit-testable. The NativeGuider service in NINA.Polaris drives it. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NINA.Core.Portable\NINA.Core.Portable.csproj" />
    <ProjectReference Include="..\NINA.Image.Portable\NINA.Image.Portable.csproj" />
  </ItemGroup>

</Project>
