---
import { site, closing } from '../data/site';
---

<section id="download" class="section section-cta">
  <div class="container">
    <h2 class="section-title">{closing.title}</h2>
    <p class="section-sub">{closing.sub}</p>
    <div class="cta-buttons">
      <a class="btn btn-primary" href="/install">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 1a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1ZM2.75 13.5a.75.75 0 0 0 0 1.5h10.5a.75.75 0 0 0 0-1.5H2.75Z"/>
        </svg>
        Download &amp; Install
      </a>
      <a class="btn btn-ghost" href="/getting-started">Get Started guide →</a>
      <a class="btn btn-ghost" href={site.repo} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        Source &amp; releases
      </a>
      <a class="btn btn-ghost" href={site.donate} target="_blank" rel="noopener">❤ Donate</a>
    </div>
    <p class="cta-fine">Free &amp; open-source · MIT-style license inherited from upstream N.I.N.A.</p>
  </div>
</section>

<style>
  .section-cta { text-align: center; }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 24px;
  }
  .cta-fine {
    margin-top: 18px;
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
