---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { getContent, localePath, type Lang } from '../data/site';
// `lang` is supplied by the page once locale routes exist; until then
// every caller omits it and getContent('en') returns the English content.
const { lang = 'en' as Lang } = Astro.props as { lang?: Lang };
const {features, featuresSection, strings} = getContent(lang);
const t = strings.features;
const g = strings.gallery;
// At build time, check whether each feature screenshot exists in public/.
// Missing images fall back to a styled placeholder, never a broken <img>.
const publicDir = new URL('../../public/', import.meta.url);
const rows = features.map((f) => {
  const exists = !!f.image && existsSync(fileURLToPath(new URL('.' + f.image, publicDir)));
  return { ...f, exists };
});
---

<section id="features" class="section">
  <div class="container">
    <h2 class="section-title">{featuresSection.title}</h2>
    <p class="section-sub">{featuresSection.sub}</p>

    <div class="feature-rows">
      {rows.map((f) => (
        <article class="feature-row">
          <div class="feature-media">
            {f.exists ? (
              <img src={f.image} alt={f.title} loading="lazy" decoding="async" />
            ) : (
              <div class="feature-placeholder" role="img" aria-label={`${f.title}: ${t.comingSoon}`}>
                <span class="ph-icon">{f.icon}</span>
                <span class="ph-note">{t.comingSoon}</span>
              </div>
            )}
          </div>
          <div class="feature-text">
            <span class="feature-icon">{f.icon}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="features-more">
      <a class="btn btn-ghost" href={localePath("/features", lang)}>{t.seeEvery}</a>
    </p>
  </div>

  <!-- Click-to-zoom lightbox for feature screenshots -->
  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label={g.screenshotAlt}>
    <button class="lightbox-close" type="button" aria-label={g.close}>×</button>
    <img class="lightbox-img" src="" alt="" />
  </div>
</section>

<script>
  const lb = document.getElementById('lightbox');
  const lbImg = lb?.querySelector('.lightbox-img') as HTMLImageElement | null;
  const closeBtn = lb?.querySelector('.lightbox-close');

  function openLightbox(src: string, alt: string) {
    if (!lb || !lbImg) return;
    lbImg.src = src;
    lbImg.alt = alt;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    if (!lb || !lbImg) return;
    lb.hidden = true;
    lbImg.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLImageElement>('.feature-media img').forEach((img) => {
    img.addEventListener('click', () => openLightbox(img.currentSrc || img.src, img.alt));
  });
  closeBtn?.addEventListener('click', closeLightbox);
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lb && !lb.hidden) closeLightbox();
  });
</script>

<style>
  .feature-rows {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .feature-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  /* Alternate the image to the other side on every second row. */
  .feature-row:nth-child(even) .feature-media { order: 2; }

  .feature-media img,
  .feature-placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }
  .feature-media img {
    display: block;
    object-fit: cover;
    background: var(--bg-input);
    cursor: zoom-in;
    transition: border-color 0.15s;
  }
  .feature-media img:hover { border-color: var(--accent); }

  .features-more { text-align: center; margin-top: 48px; }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    background: rgba(10, 9, 20, 0.93);
    backdrop-filter: blur(6px);
    cursor: zoom-out;
  }
  .lightbox[hidden] { display: none; }
  .lightbox-img {
    max-width: 94vw;
    max-height: 92vh;
    border-radius: 10px;
    border: 1px solid var(--border);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.6);
    cursor: default;
  }
  .lightbox-close {
    position: absolute;
    top: 18px;
    right: 24px;
    width: 44px;
    height: 44px;
    font-size: 28px;
    line-height: 1;
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .lightbox-close:hover { background: rgba(255, 255, 255, 0.16); color: var(--accent); }
  .feature-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background:
      radial-gradient(ellipse at 30% 30%, rgba(var(--accent-rgb), 0.14) 0%, transparent 60%),
      repeating-linear-gradient(45deg, #16213e 0 14px, #1a2440 14px 28px);
  }
  .ph-icon { font-size: 40px; opacity: 0.85; }
  .ph-note {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .feature-icon {
    font-size: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: rgba(var(--accent-rgb), 0.1);
    border-radius: 12px;
    margin-bottom: 18px;
  }
  .feature-text h3 {
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 12px;
  }
  .feature-text p {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 46ch;
  }

  @media (max-width: 820px) {
    .feature-rows { gap: 44px; }
    .feature-row {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    /* Keep image above text on every row when stacked. */
    .feature-row:nth-child(even) .feature-media { order: 0; }
    .feature-icon { width: 46px; height: 46px; margin-bottom: 14px; }
  }
</style>
