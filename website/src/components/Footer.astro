---
import { getContent, localePath, type Lang } from '../data/site';
const { lang = 'en' as Lang } = Astro.props as { lang?: Lang };
const {site, footerCols, strings} = getContent(lang);
const t = strings.footer;

// Footer links come from data, not from literal hrefs, so they need the same
// treatment as the nav: an internal path gets the reader's language, anything
// absolute or an anchor is left alone.
const linkHref = (href: string, external?: boolean) =>
  external || /^(https?:|mailto:|#)/.test(href) ? href : localePath(href, lang);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>{site.name}</strong>
      <p>{t.blurb}</p>
    </div>
    {footerCols.map((col) => (
      <div>
        <strong>{col.title}</strong>
        <ul>
          {col.links.map((l) => (
            <li>
              <a
                href={linkHref(l.href, l.external)}
                {...('external' in l && l.external === false
                  ? {}
                  : { target: '_blank', rel: 'noopener' })}
              >{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="container footer-fine">
    {t.disclaimer}
    <br />
    <span set:html={t.credit}></span>
  </div>
</footer>

<style>
  .site-footer {
    background: #11111d;
    padding: 60px 0 30px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 14px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  .site-footer strong {
    color: var(--text);
    display: block;
    margin-bottom: 10px;
    font-size: 14px;
  }
  .site-footer ul { list-style: none; }
  .site-footer li { padding: 4px 0; }
  .site-footer a { color: var(--text-muted); }
  .site-footer a:hover { color: var(--accent); }
  .footer-fine {
    border-top: 1px solid var(--border);
    padding-top: 20px;
    font-size: 12px;
    color: var(--text-muted);
    opacity: 0.6;
  }
  @media (max-width: 700px) {
    .footer-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
