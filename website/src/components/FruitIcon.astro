---
// Small multicolor fruit glyphs shown next to board names in tables.
// raspberry -> Raspberry Pi rows, orange -> Orange Pi rows.
interface Props { name: 'raspberry' | 'orange'; size?: number; }
const { name, size = 16 } = Astro.props;
---
{name === 'raspberry' ? (
  <svg viewBox="0 0 24 24" width={size} height={size} class="fruit" role="img" aria-label="Raspberry Pi">
    {/* sepal / leaves */}
    <path d="M12 10.2 9 6.6c2.1-.2 3 .9 3 2.2 0-1.3.9-2.4 3-2.2L12 10.2Z" fill="#4caf50"/>
    <path d="M12 9.6V5.4" stroke="#4caf50" stroke-width="1.3" stroke-linecap="round"/>
    {/* drupelets */}
    <circle cx="9.4" cy="12.3" r="2.25" fill="#d81b60"/>
    <circle cx="14.6" cy="12.3" r="2.25" fill="#d81b60"/>
    <circle cx="12" cy="11.7" r="2.25" fill="#e91e63"/>
    <circle cx="10.6" cy="15.1" r="2.2" fill="#c2185b"/>
    <circle cx="13.4" cy="15.1" r="2.2" fill="#c2185b"/>
    <circle cx="12" cy="17.6" r="2" fill="#ad1457"/>
    {/* highlights */}
    <circle cx="11.4" cy="11.1" r="0.6" fill="#f8bbd0"/>
    <circle cx="9.8" cy="14.5" r="0.5" fill="#f48fb1"/>
  </svg>
) : (
  <svg viewBox="0 0 24 24" width={size} height={size} class="fruit" role="img" aria-label="Orange Pi">
    {/* leaf */}
    <path d="M13.5 6.2c1.8-1.6 4-1.5 5-1.1.2 1.7-.8 3.5-2.7 4-1.5.4-2.6-.2-3.1-.8" fill="#4caf50"/>
    {/* stem */}
    <path d="M12 8.4V6" stroke="#6d4c41" stroke-width="1.3" stroke-linecap="round"/>
    {/* fruit */}
    <circle cx="12" cy="14.2" r="7" fill="#fb8c00"/>
    <circle cx="12" cy="14.2" r="7" fill="none" stroke="#ef6c00" stroke-width="0.8"/>
    {/* highlight */}
    <ellipse cx="9.4" cy="11.4" rx="2.1" ry="1.3" fill="#ffcc80" opacity="0.8"/>
  </svg>
)}

<style>
  .fruit {
    vertical-align: -3px;
    margin-right: 7px;
    flex-shrink: 0;
  }
</style>
