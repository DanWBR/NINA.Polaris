---
import { quickStart } from '../data/site';
---

<section id="getting-started" class="section section-alt">
  <div class="container">
    <h2 class="section-title">Get started in 30 seconds</h2>
    <p class="section-sub">One static binary, no runtime install. Pick your platform.</p>

    <div class="start-grid">
      {quickStart.map((s) => (
        <article class="start-card">
          <header>
            <span class="start-tag">{s.tag}</span>
            <h3>{s.title}</h3>
          </header>
          <pre><code>{s.code}</code></pre>
          <p>{s.note}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .start-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }
  .start-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
  }
  .start-card header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .start-card h3 { font-size: 19px; font-weight: 700; }
  .start-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 3px 8px;
    background: var(--accent);
    color: #fff;
    border-radius: 4px;
  }
  .start-card p { font-size: 14px; color: var(--text-muted); margin-top: 10px; }
</style>
