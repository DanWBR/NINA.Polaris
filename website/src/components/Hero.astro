---
import { site, hero, stats } from '../data/site';
import Nav from './Nav.astro';
---

<header class="hero" id="top">
  <Nav />

  <div class="hero-content">
    <span class="hero-eyebrow">{hero.eyebrow}</span>
    <h1 class="hero-title">
      {hero.titleLine1}<br />
      {hero.titleLine2}<br />
      <span class="accent">{hero.titleAccent}</span>
    </h1>
    <p class="hero-lede">{hero.lede}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={site.repo} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        Source on GitHub
      </a>
      <a class="btn btn-ghost" href="/getting-started">Get started →</a>
      <a class="btn btn-ghost" href={site.donate} target="_blank" rel="noopener">❤ Donate</a>
    </div>

    <div class="hero-stats">
      {stats.map((s) => (
        <div>
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-credit">
    IC&nbsp;434 / Horsehead &amp; Flame · M.&nbsp;Pugh, used by permission
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    /* Background comes from the shared body::before backdrop. */
    overflow: hidden;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
    padding: 60px 32px;
  }
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    padding: 6px 14px;
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.09);
    margin-bottom: 24px;
  }
  .hero-title {
    font-size: clamp(40px, 7vw, 84px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 28px;
    max-width: 900px;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
  }
  .accent { color: var(--accent); }
  .hero-lede {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--text);
    max-width: 640px;
    margin-bottom: 36px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    margin-top: 56px;
  }
  .hero-stats > div { display: flex; flex-direction: column; }
  .hero-stats strong {
    font-size: 32px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .hero-stats span {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-top: 4px;
  }

  .hero-credit {
    position: absolute;
    bottom: 12px;
    right: 16px;
    font-size: 11px;
    color: rgba(230, 236, 245, 0.4);
    letter-spacing: 0.5px;
  }

  @media (max-width: 700px) {
    .hero-content { padding: 40px 24px; }
    .hero-title { letter-spacing: -1px; }
    .hero-stats { gap: 20px; }
    .hero-stats strong { font-size: 24px; }
    .hero-credit { right: 8px; font-size: 10px; }
  }
</style>
