---
// Small line icons (24x24 viewBox, currentColor stroke) used in the
// colored square badges across the install page. Pick one with `name`.
interface Props { name: string; size?: number; }
const { name, size = 18 } = Astro.props;

const paths: Record<string, string> = {
  // SoC / board
  chip: '<rect x="7" y="7" width="10" height="10" rx="1.5"/><rect x="10.5" y="10.5" width="3" height="3" rx="0.5" fill="currentColor" stroke="none"/><path d="M9.5 7V4M14.5 7V4M9.5 20v-3M14.5 20v-3M7 9.5H4M7 14.5H4M20 9.5h-3M20 14.5h-3"/>',
  // USB stick
  usb: '<rect x="3" y="8.5" width="13" height="7" rx="1.5"/><path d="M16 10.5h3a2 2 0 0 1 2 2v0a2 2 0 0 1-2 2h-3"/><path d="M6 11.5v2M9 11.5v2"/>',
  // Terminal window
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M13 15h4"/>',
  // Windows panes
  windows: '<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>',
  // Apple silhouette (macOS builds)
  apple: '<path d="M15.4 3.3c-1.3.1-2.5 1.2-2.7 2.6 1.3-.1 2.6-1.1 2.7-2.6Z"/><path d="M17.5 12.5c0-1.9 1.1-3 1.8-3.5-.9-1.2-2.2-1.6-3.2-1.6-1.2-.1-2.3.7-2.9.7-.6 0-1.5-.7-2.6-.7-1.8 0-3.8 1.4-3.8 4.2 0 1.8.6 3.5 1.5 4.8.7 1.1 1.5 2.4 2.6 2.4 1 0 1.4-.7 2.7-.7s1.6.7 2.7.7c1.1 0 1.9-1.1 2.6-2.3.4-.7.7-1.4.9-1.8-.1 0-2.3-1-2.3-2.2Z"/>',
  // Stacked containers
  container: '<rect x="3" y="9" width="5" height="5" rx="0.6"/><rect x="9.5" y="9" width="5" height="5" rx="0.6"/><rect x="16" y="9" width="5" height="5" rx="0.6"/><rect x="6.25" y="3.5" width="5" height="5" rx="0.6"/><path d="M3 17.5h18"/>',
  // Code braces
  code: '<path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/>',
  // Plug (drivers)
  plug: '<path d="M9 3v5M15 3v5"/><path d="M7 8h10v3a5 5 0 0 1-10 0V8Z"/><path d="M12 16v5"/>',
  // Target / plate solve
  target: '<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
  // Signal / guiding
  signal: '<path d="M5 16a10 10 0 0 1 14 0M8 13a6 6 0 0 1 8 0"/><circle cx="12" cy="18" r="1.6" fill="currentColor" stroke="none"/>',
  // Magic wand (post-processing)
  wand: '<path d="M5 19l9-9"/><path d="M14 6l1.5-1.5M18 8l2-1M16 12l2 0.5M11 5l0.5-2"/><path d="M13.5 7.5l3 3" />',
  // Beaker (simulators)
  beaker: '<path d="M9 3h6M10 3v6l-4.5 8a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L15 9V3"/><path d="M7.5 15h9"/>',
  // Update (up arrow, like the in-app badge)
  update: '<path d="M12 20V7"/><path d="M6 12l6-6 6 6"/>',
  // Puzzle (integrations)
  puzzle: '<path d="M9 4a1.8 1.8 0 0 1 3.5 0c0 1 .8 1.3 1.5 1.3H17a1 1 0 0 1 1 1v2.7c0 .7.3 1.5 1.3 1.5a1.8 1.8 0 0 1 0 3.5c-1 0-1.3.8-1.3 1.5V20a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1c0-1-.8-1.3-1.5-1.3a1.8 1.8 0 0 1 0-3.5c.7 0 1.5-.3 1.5-1.2V11a1 1 0 0 0-1-1H7c-1 0-1.3-.8-1.3-1.5A1.8 1.8 0 0 1 4 7c0-1 .8-1.5 1.5-1.5H7a1 1 0 0 0 1-1V4Z"/>',
};

const inner = paths[name] ?? paths.chip;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
