---
import { getContent, LANGS, localePath, stripLangPrefix, langPrefix, type Lang } from '../data/site';
const { lang = 'en' as Lang } = Astro.props as { lang?: Lang };
const {navLinks} = getContent(lang);

// Internal links must carry the current language, or the first click from
// /pt-br/ silently drops the reader back into English.
const linkHref = (href: string, external?: boolean) =>
  external || /^(https?:|mailto:|#)/.test(href) ? href : localePath(href, lang);

// The switcher points at the SAME page in each language rather than the home
// page: being thrown back to the top of the site is the classic annoyance here.
const here = stripLangPrefix(Astro.url.pathname);
const LANG_LABEL: Record<Lang, string> = {
  en: 'English', 'pt-BR': 'Português', es: 'Español', fr: 'Français', de: 'Deutsch',
};
---

<nav class="nav">
  <a class="brand" href={localePath('/', lang)}>
    <img class="brand-badge" src="/img/polaris-badge.png" alt="Polaris Astro Controller" width="28" height="28" />
    <span class="brand-name">Polaris</span>
    <span class="brand-tag">Astro Controller</span>
  </a>

  <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>

  <div class="nav-links">
    {navLinks.map((l) => (
      <a
        href={linkHref(l.href, l.external)}
        {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
      >
        {l.label}
      </a>
    ))}

    <div class="lang-switch">
      {LANGS.map((l) => (
        <a
          href={`${langPrefix(l)}${here}` || '/'}
          hreflang={l}
          lang={l}
          class={l === lang ? 'is-current' : undefined}
          aria-current={l === lang ? 'true' : undefined}
        >{LANG_LABEL[l]}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  // Close the mobile menu after tapping a link
  document.querySelectorAll('.nav-links a').forEach((a) =>
    a.addEventListener('click', () => nav?.classList.remove('open'))
  );
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 32px;
    backdrop-filter: blur(8px);
    background: rgba(26, 26, 46, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  /* Wordmark mirrors the app header (css/app.css .brand*). */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    padding: 2px 4px;
    border-radius: 6px;
    /* One-line wordmark: never let "Astro Controller" wrap, and never let the
       brand shrink when the nav row gets tight. */
    white-space: nowrap;
    flex-shrink: 0;
  }
  .brand:hover { text-decoration: none; }
  .brand-badge {
    height: 28px;
    width: auto;
    border-radius: 4px;
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px rgba(8, 145, 178, 0.4));
  }
  .brand-name,
  .brand-tag {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 1px;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    /* Brand gradient: deep-night blue, icy cyan, stellar white. */
    background: linear-gradient(90deg, #1e3a8a 0%, #0891b2 40%, #67e8f9 75%, #f0f9ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .nav-links { display: flex; gap: 28px; }
  .nav-links a {
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--accent); text-decoration: none; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px;
  }
  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: 0.2s;
  }

  /* Collapse to the hamburger while the full row of links would still fit as a
     single line. The 10 links + wordmark need ~1100px before they crowd /
     wrap (the "Astro Controller" + "AI Tools" two-line squeeze); below that we
     hide the inline menu behind the toggle instead of letting it wrap. */
  @media (max-width: 1100px) {
    .nav { padding: 16px 20px; }
    .nav-toggle { display: flex; }
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(26, 26, 46, 0.98);
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    /* Tall enough for all 10 links (the old 320px clipped everything past
       Handbook), capped to the viewport with a scroll fallback on short
       screens. */
    .nav.open .nav-links {
      max-height: min(640px, calc(100vh - 64px));
      overflow-y: auto;
    }
    .nav-links a {
      padding: 14px 20px;
      border-top: 1px solid var(--border);
    }
  }
</style>

<style>
  /* Language switcher. Plain links, not a dropdown: they are crawlable and
     work without JavaScript, which matters because these are the URLs the
     search engine follows to find the translations. */
  .lang-switch { display: flex; gap: 10px; align-items: center; margin-left: 8px; }
  .lang-switch a { font-size: 13px; opacity: 0.7; }
  .lang-switch a:hover { opacity: 1; }
  .lang-switch a.is-current { opacity: 1; font-weight: 600; text-decoration: underline; }
</style>
