---
import { getContent, LANGS, localePath, stripLangPrefix, langPrefix, type Lang } from '../data/site';
const { lang = 'en' as Lang } = Astro.props as { lang?: Lang };
const {navLinks, strings} = getContent(lang);

// Internal links must carry the current language, or the first click from
// /pt-br/ silently drops the reader back into English.
const linkHref = (href: string, external?: boolean) =>
  external || /^(https?:|mailto:|#)/.test(href) ? href : localePath(href, lang);

// The switcher points at the SAME page in each language rather than the home
// page: being thrown back to the top of the site is the classic annoyance here.
const here = stripLangPrefix(Astro.url.pathname);
// Two-letter codes, not language names: five spelled-out names ate a third of
// the nav row. The full name stays as the link title/aria-label so the choice
// is still readable to anyone who needs it.
const LANG_CODE: Record<Lang, string> = {
  en: 'EN', 'pt-BR': 'PT', es: 'ES', fr: 'FR', de: 'DE',
};
const LANG_NAME: Record<Lang, string> = {
  en: 'English', 'pt-BR': 'Português', es: 'Español', fr: 'Français', de: 'Deutsch',
};
---

<nav class="nav">
  <a class="brand" href={localePath('/', lang)}>
    <img class="brand-badge" src="/img/polaris-badge.png" alt="Polaris Astro Controller" width="28" height="28" />
    <span class="brand-name">Polaris</span>
    <span class="brand-tag">Astro Controller</span>
  </a>

  <button class="nav-toggle" aria-label={strings.nav.toggle} aria-expanded="false">
    <span></span><span></span><span></span>
  </button>

  <div class="nav-links">
    {navLinks.map((l) => (
      <a
        href={linkHref(l.href, l.external)}
        {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
      >
        {l.label}
      </a>
    ))}

    <details class="lang-switch">
      <summary aria-label={LANG_NAME[lang]}>{LANG_CODE[lang]}</summary>
      <div class="lang-menu">
        {LANGS.map((l) => (
          <a
            href={`${langPrefix(l)}${here}` || '/'}
            hreflang={l}
            lang={l}
            title={LANG_NAME[l]}
            class={l === lang ? 'is-current' : undefined}
            aria-current={l === lang ? 'true' : undefined}
          >
            <span class="lang-code">{LANG_CODE[l]}</span>
            <span class="lang-name">{LANG_NAME[l]}</span>
          </a>
        ))}
      </div>
    </details>
  </div>
</nav>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  // Close the mobile menu after tapping a link
  document.querySelectorAll('.nav-links a').forEach((a) =>
    a.addEventListener('click', () => nav?.classList.remove('open'))
  );
  // Dismiss the language dropdown on an outside click / Escape. Progressive
  // enhancement only: with JS off, <details> still opens and closes on click.
  const langSwitch = document.querySelector('.lang-switch');
  document.addEventListener('click', (e) => {
    if (langSwitch && !langSwitch.contains(e.target as Node)) {
      langSwitch.removeAttribute('open');
    }
  });
  document.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') langSwitch?.removeAttribute('open');
  });
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 32px;
    backdrop-filter: blur(8px);
    background: rgba(26, 26, 46, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  /* Wordmark mirrors the app header (css/app.css .brand*). */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    padding: 2px 4px;
    border-radius: 6px;
    /* One-line wordmark: never let "Astro Controller" wrap, and never let the
       brand shrink when the nav row gets tight. */
    white-space: nowrap;
    flex-shrink: 0;
  }
  .brand:hover { text-decoration: none; }
  .brand-badge {
    height: 28px;
    width: auto;
    border-radius: 4px;
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px rgba(8, 145, 178, 0.4));
  }
  .brand-name,
  .brand-tag {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 1px;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    /* Brand gradient: deep-night blue, icy cyan, stellar white. */
    background: linear-gradient(90deg, #1e3a8a 0%, #0891b2 40%, #67e8f9 75%, #f0f9ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .nav-links { display: flex; gap: 28px; }
  .nav-links a {
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--accent); text-decoration: none; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px;
  }
  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: 0.2s;
  }

  /* Collapse to the hamburger while the full row of links would still fit as a
     single line. The 8 links + the language dropdown + wordmark crowd below
     ~1000px (the "Astro Controller" + "AI Tools" two-line squeeze); under that
     we hide the inline menu behind the toggle instead of letting it wrap. */
  @media (max-width: 1000px) {
    .nav { padding: 16px 20px; }
    .nav-toggle { display: flex; }
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(26, 26, 46, 0.98);
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    /* Tall enough for the 8 links plus the language dropdown, capped to the
       viewport with a scroll fallback on short screens. */
    .nav.open .nav-links {
      max-height: min(640px, calc(100vh - 64px));
      overflow-y: auto;
    }
    .nav-links a {
      padding: 14px 20px;
      border-top: 1px solid var(--border);
    }
  }
</style>

<style>
  /* Language switcher: a <details> dropdown, NOT a JS widget. The entries stay
     real <a href> links present in the served HTML, so they remain crawlable
     and work with JavaScript off — the property the previous inline row had,
     and the reason this is not a <select> with an onchange handler. The
     reciprocal hreflang tags in <head> are the primary signal either way. */
  .lang-switch { position: relative; margin-left: 8px; }
  .lang-switch summary {
    list-style: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    opacity: 0.85;
    user-select: none;
  }
  .lang-switch summary::-webkit-details-marker { display: none; }
  .lang-switch summary::after { content: ' ▾'; opacity: 0.7; }
  .lang-switch summary:hover { opacity: 1; border-color: var(--accent); }
  .lang-switch[open] summary { opacity: 1; border-color: var(--accent); }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 150px;
    padding: 4px;
    background: rgba(26, 26, 46, 0.98);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    z-index: 30;
  }
  .lang-menu a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 5px;
    font-size: 13px;
    opacity: 0.8;
  }
  .lang-menu a:hover { opacity: 1; background: rgba(255, 255, 255, 0.06); text-decoration: none; }
  .lang-menu a.is-current { opacity: 1; font-weight: 600; }
  .lang-code { min-width: 22px; font-weight: 600; letter-spacing: 0.5px; }
  .lang-name { opacity: 0.75; }

  /* In the mobile drawer the nav is a vertical stack, so the dropdown becomes
     an inline block instead of an overlay. */
  @media (max-width: 1000px) {
    .lang-switch { margin: 0; }
    .lang-switch summary { margin: 10px 20px; display: inline-block; }
    .lang-menu {
      position: static;
      min-width: 0;
      margin: 0 20px 12px;
      box-shadow: none;
    }
  }
</style>
