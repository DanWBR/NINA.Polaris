---
import '../styles/global.css';
import { getContent, LANGS, langPrefix, stripLangPrefix, type Lang } from '../data/site';
// English is the default so a page that has not been given a language still
// renders, rather than failing the build.
const { lang = 'en' as Lang } = Astro.props as { lang?: Lang };
const {site} = getContent(lang);
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name}, ${site.tagline}`,
  description = site.description,
} = Astro.props;

const ogImage = new URL(site.ogImage, Astro.site ?? Astro.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// The same page in every language, built from the current path with its
// language prefix removed. English first, so it can serve as x-default.
const bare = stripLangPrefix(Astro.url.pathname);
const altLinks = LANGS.map((l) => ({
  lang: l,
  hreflang: l,
  href: new URL(`${langPrefix(l)}${bare}` || '/', Astro.site ?? Astro.url).href,
}));
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="canonical" href={canonical} />

    {/* Reciprocal hreflang. Without it Google treats the translations as
        near-duplicates and picks one itself, usually the wrong one for the
        reader. x-default points at English, which is the source. */}
    {altLinks.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={altLinks[0].href} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#1a1a2e" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Nav lang={lang} />
    <slot />
  </body>
</html>
