---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getContent, LANGS, type Lang } from '../../data/site';
export async function getStaticPaths() {
  // `undefined` for English is what keeps it at the site root: a rest param
  // that resolves to nothing renders the page at the path with no prefix.
  return LANGS.map((l) => ({
    params: { lang: l === 'en' ? undefined : l.toLowerCase() },
    props: { lang: l },
  }));
}
const { lang } = Astro.props as { lang: Lang };
const {assistantPage: p} = getContent(lang);
// Screenshots are spaced through the page. Each is full-width; until a real
// image is dropped in (set `src`), a full-width placeholder box is shown.
const shots = p.screenshots ?? [];

// Backend capability matrix. A cell is "yes"/"no"/"partial" (rendered as a
// glyph) or any other string (rendered as plain text, e.g. Cost / Runs on).
const capColumns: string[] = (p as any).capabilitiesColumns ?? [];
const capGroups: any[] = (p as any).capabilities ?? [];
const capGlyph: Record<string, string> = { yes: '✓', no: '✗', partial: '~' };
---

<Layout lang={lang}
  title="Canopus Assistant: AI co-pilot for Polaris Astro Controller"
  description="Canopus Assistant is an optional AI companion for Polaris Astro Controller: it plans your night, drives the rig with your approval, inspects your frames, and answers astrophotography questions inside the Polaris web UI. A paid cloud plan (US$4.99/mo, 7-day trial) plus free, fully offline on-host and on-device backends."
>
  <main>

    <!-- ── Hero ─────────────────────────────────────────────────── -->
    <header class="page-head">
      <div class="container">
        <a class="back" href="/">← Back to home</a>
        <div class="head-label">CANOPUS ASSISTANT</div>
        <h1>{p.title}</h1>
        {p.tagline && <p class="tagline">{p.tagline}</p>}
        <p class="lede">{p.lede}</p>
        {/* Two of the three backends are free, so the badges lead with that
            and name the price as belonging to the cloud tier. Leading with
            the subscription read as "this is a paid product". */}
        <div class="hero-meta">
          <span class="pill pill-accent">{p.heroBadges[0]}</span>
          <span class="pill">{p.heroBadges[1]}</span>
          <span class="pill pill-ghost">{p.heroBadges[2]}</span>
        </div>
      </div>
    </header>

    <!-- ── At a glance ──────────────────────────────────────────── -->
    {p.glance && p.glance.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <h2 class="block-title">{p.glanceTitle}</h2>
          <div class="glance-grid">
            {p.glance.map((g) => (
              <div class="glance">
                <span class="glance-dot" aria-hidden="true"></span>
                <p><strong>{g.label}</strong> {g.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Screenshot 1 (full width) ─────────────────────────────── -->
    {shots[0] && (
      <section class="section shot-section">
        <div class="container">
          <figure class="shot">
            {shots[0].src && <img src={shots[0].src} alt={shots[0].caption} loading="lazy"
              onerror="var f=this.closest('.shot');this.remove();var p=f.querySelector('.shot-ph');if(p)p.style.display='grid';" />}
            <div class="shot-ph" style={shots[0].src ? 'display:none' : undefined}><span class="shot-ph-icon">🔭</span><span class="shot-ph-tag">Screenshot</span></div>
            <figcaption>{shots[0].caption}</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- ── Features ──────────────────────────────────────────────── -->
    <section class="section">
      <div class="container">
        <h2 class="block-title">{p.featuresTitle}</h2>
        <div class="panels">
          {p.features.map((f) => (
            <article class="panel">
              <header class="panel-head">
                <span class="sq-icon" style={f.color ? `--ic: ${f.color}` : undefined}>{f.icon}</span>
                <div class="panel-id"><h3>{f.title}</h3></div>
              </header>
              {f.intro && <p class="panel-intro">{f.intro}</p>}
              <ul class="panel-list">
                {f.items.map((it) => (
                  <li>
                    {it.label && <strong>{it.label}</strong>}
                    {it.label && it.text ? ' ' : ''}
                    {it.text}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Screenshot 2 (full width) ─────────────────────────────── -->
    {shots[1] && (
      <section class="section shot-section section-alt">
        <div class="container">
          <figure class="shot">
            {shots[1].src && <img src={shots[1].src} alt={shots[1].caption} loading="lazy"
              onerror="var f=this.closest('.shot');this.remove();var p=f.querySelector('.shot-ph');if(p)p.style.display='grid';" />}
            <div class="shot-ph" style={shots[1].src ? 'display:none' : undefined}><span class="shot-ph-icon">🗓️</span><span class="shot-ph-tag">Screenshot</span></div>
            <figcaption>{shots[1].caption}</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- ── How it works ──────────────────────────────────────────── -->
    <section class="section">
      <div class="container">
        <h2 class="block-title">{p.howTitle}</h2>
        <p class="section-lede">{p.howLede}</p>
        <div class="how-grid">
          {p.how.map((h, i) => (
            <div class="how-card">
              <span class="how-num">{i + 1}</span>
              <p><strong>{h.label}</strong> {h.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Backends & requirements ───────────────────────────────── -->
    {p.backends && p.backends.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <h2 class="block-title">{p.backendsTitle}</h2>
          {p.backendsLede && <p class="section-lede">{p.backendsLede}</p>}
          <div class="panels">
            {p.backends.map((b) => (
              <article class="panel">
                <header class="panel-head">
                  <span class="sq-icon" style={b.color ? `--ic: ${b.color}` : undefined}>{b.icon}</span>
                  <div class="panel-id">
                    <h3>{b.title}</h3>
                    {b.tag && <p class="panel-tag">{b.tag}</p>}
                  </div>
                </header>
                {b.intro && <p class="panel-intro">{b.intro}</p>}
                <ul class="panel-list">
                  {b.items.map((it) => (
                    <li>
                      {it.label && <strong>{it.label}</strong>}
                      {it.label && it.text ? ' ' : ''}
                      {it.text}
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
          {p.backendsShot && (
            <figure class="shot" style="margin-top:32px">
              {p.backendsShot.src && <img src={p.backendsShot.src} alt={p.backendsShot.caption} loading="lazy"
                onerror="var f=this.closest('.shot');this.remove();var ph=f.querySelector('.shot-ph');if(ph)ph.style.display='grid';" />}
              <div class="shot-ph" style={p.backendsShot.src ? 'display:none' : undefined}><span class="shot-ph-icon">⚙️</span><span class="shot-ph-tag">Screenshot</span></div>
              <figcaption>{p.backendsShot.caption}</figcaption>
            </figure>
          )}
        </div>
      </section>
    )}

    <!-- ── Backend capability matrix ─────────────────────────────── -->
    {capGroups.length > 0 && capColumns.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="block-title">{(p as any).capabilitiesTitle}</h2>
          {(p as any).capabilitiesLede && <p class="section-lede">{(p as any).capabilitiesLede}</p>}
          <div class="cap-wrap">
            <table class="cap">
              <thead>
                <tr>
                  <th class="left">Capability</th>
                  {capColumns.map((c) => <th>{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {capGroups.map((g: any) => (
                  <>
                    <tr class="cap-group">
                      <td class="left" colspan={capColumns.length + 1}>{g.group}</td>
                    </tr>
                    {g.rows.map((r: any) => (
                      <tr>
                        <td class="left">
                          <span class="cap-feat">{r.feature}</span>
                          {r.tools && <code class="cap-tools">{r.tools}</code>}
                        </td>
                        {r.cells.map((cell: string) => (
                          <td>
                            {capGlyph[cell]
                              ? <span class={`cap-mark cm-${cell}`}>{capGlyph[cell]}</span>
                              : <span class="cap-text">{cell}</span>}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>
          {(p as any).capabilitiesNote && <p class="cap-note">{(p as any).capabilitiesNote}</p>}
        </div>
      </section>
    )}

    <!-- ── Screenshot 3 (full width) ─────────────────────────────── -->
    {shots[2] && (
      <section class="section shot-section">
        <div class="container">
          <figure class="shot">
            {shots[2].src && <img src={shots[2].src} alt={shots[2].caption} loading="lazy"
              onerror="var f=this.closest('.shot');this.remove();var p=f.querySelector('.shot-ph');if(p)p.style.display='grid';" />}
            <div class="shot-ph" style={shots[2].src ? 'display:none' : undefined}><span class="shot-ph-icon">📷</span><span class="shot-ph-tag">Screenshot</span></div>
            <figcaption>{shots[2].caption}</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- ── Screenshot 4 (full width) ─────────────────────────────── -->
    {shots[3] && (
      <section class="section shot-section section-alt">
        <div class="container">
          <figure class="shot">
            {shots[3].src && <img src={shots[3].src} alt={shots[3].caption} loading="lazy"
              onerror="var f=this.closest('.shot');this.remove();var p=f.querySelector('.shot-ph');if(p)p.style.display='grid';" />}
            <div class="shot-ph" style={shots[3].src ? 'display:none' : undefined}><span class="shot-ph-icon">🖼️</span><span class="shot-ph-tag">Screenshot</span></div>
            <figcaption>{shots[3].caption}</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- ── Pricing ───────────────────────────────────────────────── -->
    <section class="section section-alt">
      <div class="container">
        <h2 class="block-title">{p.pricingTitle}</h2>
        {p.pricingLede && <p class="section-lede">{p.pricingLede}</p>}
        <div class="price-card">
          <div class="price-main">
            <span class="price-amount">{p.pricing.price}</span>
            <span class="price-period">{p.pricing.period}</span>
          </div>
          <div class="price-body">
            <p class="price-trial">✨ {p.pricing.trial}</p>
            <p class="price-note">{p.pricing.note}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Footer CTA ────────────────────────────────────────────── -->
    <section class="section cta-section">
      <div class="container cta-inner">
        <p class="cta-text">{p.ctaText}</p>
        <a class="btn-primary" href={p.ctaHref}>{p.ctaButton}</a>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

<style>
  /* ── Layout helpers (shared look with the AI Tools page) ──── */
  .section       { padding: 56px 0; }
  .section-alt   { background: var(--panel); }
  .block-title   { font-size: clamp(22px, 3vw, 30px); font-weight: 700; letter-spacing: -0.5px; margin-bottom: 8px; }
  .section-lede  { font-size: 15px; color: var(--text-muted); max-width: 72ch; line-height: 1.6; margin-bottom: 32px; }

  /* ── Page header ────────────────────────────────────────── */
  .page-head { padding: 56px 0 40px; border-bottom: 1px solid var(--border); }
  .back { display: inline-block; font-size: 14px; margin-bottom: 18px; color: var(--text-muted); }
  .back:hover { color: var(--accent); text-decoration: none; }
  .head-label { font-size: 12px; font-weight: 700; letter-spacing: 2px; color: var(--accent); text-transform: uppercase; margin-bottom: 10px; }
  .page-head h1 { font-size: clamp(30px, 5vw, 48px); font-weight: 800; letter-spacing: -1px; margin-bottom: 10px; }
  .tagline { font-size: 18px; font-weight: 600; color: var(--text); margin-bottom: 12px; }
  .lede { font-size: 17px; color: var(--text-muted); max-width: 80ch; line-height: 1.6; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .pill {
    font-size: 13px; font-weight: 600; padding: 6px 13px; border-radius: 99px;
    background: var(--panel); border: 1px solid var(--border); color: var(--text);
  }
  .pill-accent {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    color: color-mix(in srgb, var(--accent) 90%, var(--text));
  }
  .pill-ghost { color: var(--text-muted); }

  /* ── At a glance ────────────────────────────────────────── */
  .glance-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .glance { display: flex; gap: 12px; align-items: flex-start; }
  .glance-dot { margin-top: 8px; width: 8px; height: 8px; flex-shrink: 0; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.7); }
  .glance p { font-size: 15px; color: var(--text-muted); line-height: 1.55; }
  .glance strong { color: var(--text); }

  /* ── Full-width screenshots ─────────────────────────────── */
  .shot-section { padding: 40px 0; }
  .shot { width: 100%; margin: 0; }
  .shot img,
  .shot-ph {
    display: block; width: 100%; border-radius: 14px;
    border: 1px solid var(--border);
  }
  .shot img { height: auto; box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35); }
  .shot-ph {
    aspect-ratio: 16 / 9;
    display: grid; place-content: center; gap: 8px; justify-items: center;
    background:
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--accent) 5%, transparent) 0 12px, transparent 12px 24px),
      var(--panel);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    color: var(--text-muted);
  }
  .shot-ph-icon { font-size: 40px; opacity: 0.85; }
  .shot-ph-tag { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
  .shot figcaption { margin-top: 12px; font-size: 14px; color: var(--text-muted); text-align: center; }

  /* ── Feature panels ─────────────────────────────────────── */
  .panels { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 24px; align-items: start; }
  .panel { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 24px; }
  .section-alt .panel { background: var(--bg); }
  .panel-head { display: flex; align-items: center; gap: 13px; margin-bottom: 12px; }
  .sq-icon {
    --ic: var(--accent);
    width: 42px; height: 42px; flex-shrink: 0; display: grid; place-items: center; font-size: 20px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--ic) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--ic) 40%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--ic) 22%, transparent);
  }
  .panel-id { min-width: 0; }
  .panel-id h3 { font-size: 17px; font-weight: 800; letter-spacing: 0.2px; line-height: 1.1; }
  .panel-tag { font-size: 12.5px; color: var(--text-muted); line-height: 1.35; margin-top: 3px; }
  .panel-intro { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 14px; }
  .panel-list { list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .panel-list li { position: relative; padding-left: 18px; font-size: 13.5px; color: var(--text-muted); line-height: 1.55; }
  .panel-list li::before { content: ""; position: absolute; left: 2px; top: 8px; width: 6px; height: 6px; border-radius: 50%; background: color-mix(in srgb, var(--accent) 70%, transparent); }
  .panel-list strong { color: var(--text); font-weight: 600; }

  /* ── How it works ───────────────────────────────────────── */
  .how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .how-card { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 22px; display: flex; gap: 14px; align-items: flex-start; }
  .how-num {
    flex-shrink: 0; width: 30px; height: 30px; display: grid; place-items: center;
    border-radius: 50%; font-size: 14px; font-weight: 800; color: #fff; background: var(--accent);
  }
  .how-card p { font-size: 14px; color: var(--text-muted); line-height: 1.6; }
  .how-card strong { color: var(--text); }

  /* ── Pricing ────────────────────────────────────────────── */
  .price-card {
    display: flex; flex-wrap: wrap; align-items: center; gap: 28px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 16px; padding: 28px 32px;
    max-width: 620px;
  }
  .price-main { display: flex; align-items: baseline; gap: 8px; }
  .price-amount { font-size: 40px; font-weight: 800; letter-spacing: -1px; color: var(--text); }
  .price-period { font-size: 15px; color: var(--text-muted); }
  .price-body { min-width: 220px; flex: 1; }
  .price-trial { font-size: 15px; font-weight: 700; color: color-mix(in srgb, var(--accent) 90%, var(--text)); margin-bottom: 4px; }
  .price-note { font-size: 13.5px; color: var(--text-muted); line-height: 1.55; }

  /* ── CTA ─────────────────────────────────────────────────── */
  .cta-section { padding: 48px 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-text { font-size: 17px; font-weight: 600; color: var(--text); max-width: 60ch; }
  .btn-primary {
    display: inline-block; padding: 12px 28px; background: var(--accent); color: #fff;
    border-radius: 8px; font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap; transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.88; text-decoration: none; }

  /* ── Backend capability matrix ──────────────────────────── */
  .cap-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg);
  }
  .cap {
    width: 100%;
    border-collapse: collapse;
    min-width: 720px;
    font-size: 15px;
  }
  .cap thead th {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--text);
    text-align: center;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .cap thead th.left { text-align: left; }
  .cap td {
    padding: 12px 16px;
    text-align: center;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  .cap tbody tr:last-child td { border-bottom: 0; }
  .cap td.left { text-align: left; }
  .cap .left { min-width: 320px; }

  .cap-group td {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 85%, var(--text));
    padding: 9px 16px;
  }
  .cap-feat { display: block; color: var(--text); font-weight: 600; line-height: 1.45; }
  .cap-tools {
    display: block;
    margin-top: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
    white-space: normal;
    word-break: break-word;
  }
  .cap-mark { font-size: 19px; font-weight: 800; line-height: 1; }
  .cm-yes { color: var(--success, #22c55e); }
  .cm-no { color: var(--text-muted); opacity: 0.5; }
  .cm-partial { color: var(--warning, #eab308); }
  .cap-text { font-size: 13.5px; color: var(--text); line-height: 1.4; display: inline-block; }
  .cap-note {
    font-size: 14px;
    color: var(--text-muted);
    max-width: 820px;
    margin: 16px auto 0;
    text-align: center;
    line-height: 1.6;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 600px) {
    .panels, .how-grid { grid-template-columns: 1fr; }
    .glance-grid { grid-template-columns: 1fr; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
    .price-card { flex-direction: column; align-items: flex-start; gap: 16px; }
    .cap .left { min-width: 220px; }
  }
</style>
