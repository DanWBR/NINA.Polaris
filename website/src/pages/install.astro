---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { installGuide as g } from '../data/site';

// Map a free-text status to a colour class for the requirements table.
const statusClass = (s: string) => {
  const t = (s || '').toLowerCase();
  if (t.includes('recommend') || t.includes('full') || t === 'good') return 'ok';
  if (t.includes('testing') || t.includes('tbd')) return 'pending';
  if (t.includes('below') || t.includes('limit')) return 'warn';
  return '';
};
---

<Layout
  title={`${g.title}, N.I.N.A. Polaris`}
  description="Install N.I.N.A. Polaris on Raspberry Pi, Linux, Windows, or Docker, plus the optional components for plate solving, guiding, post-processing, and more."
>
  <main>
    <header class="page-head">
      <div class="container">
        <a class="back" href="/">← Back to home</a>
        <h1>{g.title}</h1>
        <p class="lede">{g.lede}</p>
      </div>
    </header>

    <!-- Ready-to-flash images -->
    <section id="sd-images" class="section section-alt">
      <div class="container">
        <h2 class="block-title">{g.images.title}</h2>
        <p class="block-sub">{g.images.sub}</p>
        {g.images.bootNote && (
          <div class="img-boot">
            <span class="img-boot-ico" aria-hidden="true">📡</span>
            <p>{g.images.bootNote}</p>
          </div>
        )}
        <div class="img-grid">
          {g.images.items.map((it) => (
            <article class="img-card">
              <header>
                <div class="img-id">
                  <span class="img-icon" style={it.color ? `--ic: ${it.color}` : undefined}>
                    {it.badge === 'x86-64' ? (
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="8.5" width="13" height="7" rx="1.5"/>
                        <path d="M16 10.5h3a2 2 0 0 1 2 2v0a2 2 0 0 1-2 2h-3"/>
                        <path d="M6 11.5v2M9 11.5v2"/>
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="7" y="7" width="10" height="10" rx="1.5"/>
                        <rect x="10.5" y="10.5" width="3" height="3" rx="0.5" fill="currentColor" stroke="none"/>
                        <path d="M9.5 7V4M14.5 7V4M9.5 20v-3M14.5 20v-3M7 9.5H4M7 14.5H4M20 9.5h-3M20 14.5h-3"/>
                      </svg>
                    )}
                  </span>
                  <h3>{it.device}</h3>
                </div>
                {it.badge && <span class="badge">{it.badge}</span>}
              </header>
              {(it.gpu || it.npu) && (
                <div class="caps">
                  {it.gpu && (
                    <span class={`cap ${it.gpu === 'yes' ? 'ok' : 'no'}`}>
                      {it.gpu === 'yes' ? '✓' : '✕'} GPU · OpenCL
                    </span>
                  )}
                  {it.npu && (
                    <span class={`cap ${it.npu === 'yes' ? 'ok' : 'no'}`}>
                      {it.npu === 'yes' ? '✓' : '✕'} NPU · AI
                    </span>
                  )}
                </div>
              )}
              {(it.os || it.polaris || it.size) && (
                <dl class="img-spec">
                  {it.os && (<div class="img-spec-row"><dt>OS</dt><dd>{it.os}</dd></div>)}
                  {it.polaris && (<div class="img-spec-row"><dt>Polaris</dt><dd>{it.polaris}</dd></div>)}
                  {it.size && (<div class="img-spec-row"><dt>Size</dt><dd class="mono">{it.size}</dd></div>)}
                </dl>
              )}
              {it.note && <p class="img-note">{it.note}</p>}
              {it.url ? (
                <a class="btn btn-primary img-btn" href={it.url} target="_blank" rel="noopener">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M8 1a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1ZM2.75 13.5a.75.75 0 0 0 0 1.5h10.5a.75.75 0 0 0 0-1.5H2.75Z"/>
                  </svg>
                  Download image
                </a>
              ) : (
                <span class="soon">Coming soon</span>
              )}
            </article>
          ))}
        </div>
        {g.images.update && (
          <div class="img-update">
            <h3 class="img-update-title">{g.images.update.title}</h3>
            <p class="img-update-intro">{g.images.update.intro}</p>
            <pre><code>{g.images.update.code}</code></pre>
            {g.images.update.note && <p class="muted-note">{g.images.update.note}</p>}
          </div>
        )}
      </div>
    </section>

    <!-- Download -->
    <section id="download" class="section">
      <div class="container">
        <h2 class="block-title">{g.download.title}</h2>
        <p class="block-sub">{g.download.sub}</p>
        <div class="dl-groups">
          {g.download.groups.map((grp) => (
            <div class="dl-group">
              <h3 class="dl-group-name">{grp.name}</h3>
              {grp.note && <p class="dl-group-note">{grp.note}</p>}
              <div class="dl-row">
                {grp.items.map((d) => (
                  <a class="dl-link" href={d.url} target="_blank" rel="noopener">
                    <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                      <path d="M8 1a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1ZM2.75 13.5a.75.75 0 0 0 0 1.5h10.5a.75.75 0 0 0 0-1.5H2.75Z"/>
                    </svg>
                    <span class="dl-label">{d.label}</span>
                    {d.badge && <span class="badge alt">{d.badge}</span>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Install -->
    <section id="install" class="section section-alt">
      <div class="container">
        <h2 class="block-title">{g.platformsSection.title}</h2>
        <p class="block-sub">{g.platformsSection.sub}</p>
        <div class="plat-grid">
          {g.platforms.map((p) => (
            <article class="plat-card">
              <header>
                <h3>{p.name}</h3>
                <span class="badge">{p.badge}</span>
              </header>
              <p class="plat-summary">{p.summary}</p>
              <pre><code>{p.steps}</code></pre>
              <p class="plat-note">{p.notes}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- System requirements -->
    <section id="requirements" class="section">
      <div class="container">
        <h2 class="block-title">{g.requirements.title}</h2>
        <p class="block-sub">{g.requirements.sub}</p>

        <div class="callouts">
          <div class="callout ram">
            <span class="callout-ico" aria-hidden="true">🧠</span>
            <p>{g.requirements.ramNote}</p>
          </div>
          {g.requirements.recommendedNote && (
            <div class="callout rec">
              <span class="callout-ico" aria-hidden="true">⭐</span>
              <p>{g.requirements.recommendedNote}</p>
            </div>
          )}
        </div>

        <div class="table-wrap">
          <table class="grid-table">
            <thead>
              <tr>
                <th class="left">Host</th>
                <th>RAM</th>
                <th>Status</th>
                <th class="left">Notes</th>
              </tr>
            </thead>
            <tbody>
              {g.requirements.rows.map((r) => (
                <tr class={r.highlight ? 'is-highlight' : ''}>
                  <td class="left rowlabel">
                    {r.host}
                    {r.highlight && <span class="gpu-tag">GPU + NPU</span>}
                  </td>
                  <td class="nowrap">{r.ram}</td>
                  <td><span class={`status ${statusClass(r.status)}`}>{r.status}</span></td>
                  <td class="left">{r.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TL;DR -->
    <section class="section section-alt">
      <div class="container narrow">
        <h2 class="block-title">{g.tldr.title}</h2>
        <div class="table-wrap">
          <table class="grid-table">
            <thead>
              <tr><th class="left"></th><th>Windows</th><th>Linux (RPi / x64)</th></tr>
            </thead>
            <tbody>
              {g.tldr.rows.map((r) => (
                <tr>
                  <td class="left rowlabel">{r.label}</td>
                  <td>{r.windows}</td>
                  <td>{r.linux}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="muted-note">{g.tldr.note}</p>
      </div>
    </section>

    <!-- Firewall -->
    <section class="section">
      <div class="container narrow">
        <h2 class="block-title">{g.firewall.title}</h2>
        <p class="block-sub">{g.firewall.sub}</p>
        <div class="fw-grid">
          <div>
            <span class="os-label">Windows (Admin PowerShell)</span>
            <pre><code>{g.firewall.windows}</code></pre>
          </div>
          <div>
            <span class="os-label">Linux</span>
            <pre><code>{g.firewall.linux}</code></pre>
          </div>
        </div>
        <p class="muted-note">{g.firewall.note}</p>
      </div>
    </section>

    <!-- Optional components -->
    <section id="optional" class="section section-alt">
      <div class="container">
        <h2 class="block-title">{g.optionalSection.title}</h2>
        <p class="block-sub">{g.optionalSection.sub}</p>

        <div class="groups">
          {g.optionalGroups.map((grp) => (
            <div class="group">
              <h3 class="group-name">{grp.name}</h3>
              <p class="group-intro">{grp.intro}</p>
              <div class="items">
                {grp.items.map((it) => (
                  <article class="opt-item">
                    <div class="opt-head">
                      <h4>{it.name}</h4>
                      {it.badge && <span class="badge alt">{it.badge}</span>}
                    </div>
                    <p class="opt-purpose">{it.purpose}</p>
                    <dl class="opt-os">
                      <div><dt>Windows</dt><dd>{it.windows}</dd></div>
                      <div><dt>Linux</dt><dd>{it.linux}</dd></div>
                    </dl>
                    {it.url && (
                      <a class="opt-link" href={it.url} target="_blank" rel="noopener">Get it ↗</a>
                    )}
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-head {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--border);
    /* Background comes from the shared body::before backdrop. */
  }
  .back {
    display: inline-block;
    font-size: 14px;
    margin-bottom: 18px;
    color: var(--text-muted);
  }
  .back:hover { color: var(--accent); text-decoration: none; }
  .page-head h1 {
    font-size: clamp(30px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 14px;
  }
  .lede {
    font-size: 17px;
    color: var(--text-muted);
    max-width: 70ch;
    line-height: 1.6;
  }

  .container.narrow { max-width: 880px; }
  .section { padding: 56px 0; }

  .block-title {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
  }
  .block-sub {
    font-size: 16px;
    color: var(--text-muted);
    margin-bottom: 28px;
    max-width: 70ch;
  }
  .muted-note {
    font-size: 13.5px;
    color: var(--text-muted);
    margin-top: 16px;
    line-height: 1.55;
  }

  /* TL;DR table */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
  }
  .grid-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: 14px;
  }
  .grid-table th,
  .grid-table td {
    padding: 13px 16px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .grid-table tbody tr:last-child td { border-bottom: 0; }
  .grid-table thead th {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    font-weight: 700;
  }
  .grid-table td { color: var(--text-muted); }
  .rowlabel { color: var(--text); font-weight: 600; white-space: nowrap; }
  .nowrap { white-space: nowrap; }

  /* Callouts */
  .callouts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 26px;
  }
  .callout {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border-radius: 12px;
    padding: 18px 20px;
    border: 1px solid var(--border);
  }
  .callout.ram {
    background: rgba(var(--accent-rgb), 0.06);
    border-color: rgba(var(--accent-rgb), 0.25);
    border-left: 3px solid var(--accent);
  }
  .callout.rec {
    background: rgba(255, 152, 0, 0.07);
    border-color: rgba(255, 152, 0, 0.35);
    border-left: 3px solid var(--warning);
  }
  .callout-ico { font-size: 24px; line-height: 1.2; }
  .callout p { font-size: 14.5px; color: var(--text); line-height: 1.6; }

  @media (max-width: 760px) {
    .callouts { grid-template-columns: 1fr; }
  }

  /* Status pill in the requirements table */
  .status {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .status.ok { color: var(--accent); border-color: rgba(var(--accent-rgb), 0.4); background: rgba(var(--accent-rgb), 0.1); }
  .status.warn { color: var(--warning); border-color: rgba(255, 152, 0, 0.4); background: rgba(255, 152, 0, 0.1); }
  .status.pending { color: var(--text-muted); border-style: dashed; }

  /* Highlighted rows: the GPU + NPU capable boards */
  .grid-table tr.is-highlight { background: rgba(var(--accent-rgb), 0.07); }
  .gpu-tag {
    display: inline-block;
    margin-left: 10px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 999px;
    padding: 2px 7px;
    vertical-align: middle;
    white-space: nowrap;
  }

  /* Platform cards */
  .plat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 20px;
  }
  .plat-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
  }
  .plat-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  .plat-card h3 { font-size: 18px; font-weight: 700; }
  .plat-summary { font-size: 14px; color: var(--text-muted); line-height: 1.55; margin-bottom: 12px; }
  .plat-card pre { margin: 0 0 12px; }
  .plat-note { font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-top: auto; }

  .badge {
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-radius: 999px;
    padding: 3px 10px;
    white-space: nowrap;
  }
  .badge.alt { color: var(--text-muted); border-color: var(--border); background: rgba(255, 255, 255, 0.03); }

  /* Ready-to-flash image cards */
  .img-boot {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: rgba(var(--accent-rgb), 0.08);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 24px;
  }
  .img-boot-ico { font-size: 22px; line-height: 1.2; }
  .img-boot p { font-size: 14.5px; color: var(--text); line-height: 1.6; }

  /* Update-an-image block */
  .img-update {
    margin-top: 30px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
    max-width: 780px;
  }
  .img-update-title { font-size: 17px; font-weight: 700; margin-bottom: 8px; }
  .img-update-intro { font-size: 14.5px; color: var(--text-muted); line-height: 1.6; }
  .img-update pre { margin: 14px 0 0; }
  .img-update .muted-note { margin-top: 12px; }

  .img-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }
  .img-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }
  .img-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  .img-card h3 { font-size: 16px; font-weight: 700; }
  .img-id { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .img-icon {
    --ic: var(--accent);
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 10px;
    color: var(--ic);
    background: color-mix(in srgb, var(--ic) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--ic) 40%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--ic) 22%, transparent);
  }
  .img-spec { margin: 0 0 14px; display: flex; flex-direction: column; gap: 8px; }
  .img-spec-row { display: grid; grid-template-columns: 54px 1fr; gap: 10px; align-items: baseline; }
  .img-spec dt {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    opacity: 0.7;
  }
  .img-spec dd { margin: 0; font-size: 13.5px; color: var(--text); line-height: 1.4; }
  .img-spec dd.mono { font-family: var(--font-mono); font-size: 12.5px; color: var(--text-muted); }
  .img-note { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 14px; opacity: 0.85; }

  /* Capability badges (GPU / NPU) */
  .caps { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .cap {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    border-radius: 999px;
    padding: 3px 9px;
    white-space: nowrap;
  }
  .cap.ok { color: var(--success); border: 1px solid rgba(76, 175, 80, 0.45); background: rgba(76, 175, 80, 0.1); }
  .cap.no { color: var(--text-muted); border: 1px dashed var(--border); }
  .img-btn { margin-top: auto; align-self: flex-start; padding: 9px 16px; font-size: 14px; }
  .soon {
    margin-top: auto;
    align-self: flex-start;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 6px 12px;
  }

  /* Download links */
  .dl-groups { display: flex; flex-direction: column; gap: 28px; }
  .dl-group-name {
    font-size: 16px;
    font-weight: 700;
    border-left: 3px solid var(--accent);
    padding-left: 12px;
    margin-bottom: 6px;
  }
  .dl-group-note { font-size: 13.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 14px; max-width: 70ch; }
  .dl-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .dl-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 16px;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    transition: all 0.15s;
  }
  .dl-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  /* Firewall */
  .fw-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .fw-grid pre { margin: 8px 0 0; }
  .os-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
  }

  /* Optional groups */
  .groups { display: flex; flex-direction: column; gap: 44px; }
  .group-name {
    font-size: 20px;
    font-weight: 700;
    border-left: 3px solid var(--accent);
    padding-left: 12px;
    margin-bottom: 8px;
  }
  .group-intro { font-size: 14.5px; color: var(--text-muted); line-height: 1.55; margin-bottom: 20px; max-width: 80ch; }
  .items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 16px;
  }
  .opt-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
